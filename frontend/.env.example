# NekoAPI — example environment. Secrets and deployment-specific values only.
# Branding, site name, description, hero image etc. live in
# frontend/src/config.js instead — edit that file directly, it's not a secret.

# ---- Frontend (Vite, exposed to the browser) ----

# OPTIONAL. Empty = frontend calls the API on the same origin it's served
# from (the usual setup). Set this only if the frontend and backend are
# deployed on different domains, e.g. dashboard on Vercel + API on a VPS.
VITE_API_BASE_URL=

# ---- Backend (server only, never exposed to the browser) ----

# OPTIONAL. Defaults to 8080 in code if left empty.
PORT=8080

# REQUIRED whenever the frontend is on a different domain than the backend —
# without it, browsers block every request with a CORS error. Comma-separated,
# no trailing slash. Not needed if frontend and backend share one origin.
ALLOWED_ORIGINS=https://your-domain.com

# OPTIONAL. Empty = the Telegram notifier (/telegram/status, /telegram/send)
# just reports "unconfigured" instead of erroring. Only needed if you want
# the bot to actually push logs/errors/reports to Telegram.
TELEGRAM_BOT_TOKEN=

# OPTIONAL. Empty = stats/logs live in memory only (reset on restart, fine
# for most deployments). Not yet wired to an actual database connection —
# currently only changes what /status reports.
DATABASE_URL=

# OPTIONAL. Reserved for future privileged/admin routes. Nothing in the
# codebase reads this yet — safe to leave empty.
API_SECRET=
