# ============================================
# NekoAPI — Environment Configuration
# Cuma yang WAJIB beda tiap deploy / rahasia yang taruh di sini.
# Pengaturan lain (nama API, rate limit, dll) ada di src/config/settings.json
# Salin file ini ke .env lalu isi nilainya. JANGAN commit file .env ke git.
# ============================================

# Port server
PORT=4000

# URL publik tempat API ini di-deploy (TANPA trailing slash).
# Dipakai untuk meta tag og:url/canonical, robots.txt, sitemap.xml, log webhook.
SITE_URL=http://localhost:4000
# Contoh produksi:
# SITE_URL=https://api.nimzz.dev

# ---------- Telegram Webhook (notifikasi keamanan) ----------
# Buat bot lewat @BotFather di Telegram untuk dapat BOT_TOKEN.
# CHAT_ID bisa berupa chat pribadi, grup (diawali -), atau channel.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Secret path untuk endpoint penerima webhook Telegram (POST /webhook/telegram/<secret>)
TELEGRAM_WEBHOOK_SECRET=ganti-dengan-string-acak
