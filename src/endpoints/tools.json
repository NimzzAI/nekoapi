        "description": "Teks yang ingin di-encode atau di-decode"
      },
      {
        "name": "mode",
        "required": false,
        "description": "Pilihan: encode atau decode (default: encode)"
      }
    ]
  },
  {
    "name": "Hash Generator",
    "endpoint": "/api/tools/hash",
    "filename": "hash",
    "method": "GET",
    "params": [
      {
        "name": "text",
        "required": false,
        "description": "Teks yang ingin di-hash"
      },
      {
        "name": "type",
        "required": false,
        "description": "Pilihan algoritma: md5, sha1, sha256, sha512, all (default: all)"
      }
