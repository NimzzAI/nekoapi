        "description": "Angka untuk primes count atau Fibonacci (default: 45)"
      },
      {
        "name": "iterations",
        "required": false,
        "description": "Jumlah iterasi benchmark (default: 50000)"
      }
    ]
  },
  {
    "name": "Base64 Converter",
    "endpoint": "/api/tools/base64",
    "filename": "base64",
