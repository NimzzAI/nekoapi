  {
    "name": "Rust System & Compute Engine",
    "endpoint": "/api/tools/rust-system",
    "filename": "rust-system",
    "method": "GET",
    "params": [
      {
        "name": "mode",
        "required": false,
        "description": "Mode kalkulasi: system, hash, primes, fibonacci (default: system)"
      },
      {
        "name": "text",
        "required": false,
        "description": "Teks untuk FNV-1a, Murmur3, dan CRC32 hashing"
      },
      {
        "name": "n",
